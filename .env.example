# ==============================================================================
# MUNVault Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# DO NOT commit real secrets or .env files to version control!

# Application Environment
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Connection (Default: local SQLite database file via Prisma)
# In production, this can point to a PostgreSQL connection URI
DATABASE_URL="file:./dev.db"

# AI Provider API Keys (Optional - Local mock fallback automatically enabled if omitted)
# OpenAI API Key for GPT-4o / embeddings
OPENAI_API_KEY=""

# Anthropic Claude API Key (optional fallback/alternative)
ANTHROPIC_API_KEY=""

# Local File Upload Storage Directory
UPLOAD_DIR="./data/uploads"

# NextAuth / Session Secret (generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET="change-this-to-a-secure-random-secret-in-production"
NEXTAUTH_URL="http://localhost:3000"
